# /etc/server-backup/backup.conf — configuration of /usr/local/sbin/server-backup
# (bash syntax; root:root, mode 600). Setup: deploy/backup/README.md.
#
# Paths are either absolute host paths or "volume:<docker volume>:<path inside
# the volume>" (the script resolves the volume's mountpoint itself).

# === Where the backup goes: exactly one of A or B ===========================

# --- A) Local repository (start here) ----------------------------------------
# A directory on this server, created root-only by "server-backup --init".
# Protects against mistakes, bad deploys and broken databases, NOT against
# losing or compromising the server (README: „Was lokal NICHT schützt“).
RESTIC_REPOSITORY="/var/backups/restic/$(hostname)"
# Warn and alert when the disk of the repository has less free space than this
# (whichever is hit first; 0 disables a limit). The live databases share it.
MIN_FREE_GB=5
MIN_FREE_PERCENT=15

# --- B) Hetzner Storage Box (later; README „Stufe 2“) ------------------------
# "storagebox" is the host alias from /root/.ssh/config (port 23, see the
# README); the path is relative to the home directory of the Storage Box
# sub-account. To switch: comment out
# RESTIC_REPOSITORY in A, activate this line and add /root/.ssh/config to
# BACKUP_PATHS below. Nothing else changes.
# RESTIC_REPOSITORY="sftp:storagebox:restic/$(hostname)"

# ==============================================================================

RESTIC_PASSWORD_FILE=/etc/server-backup/restic-password

# Live SQLite databases, copied consistently while the apps keep running:
# "name=path". Never list them in BACKUP_PATHS as well (a plain file copy of a
# database that is being written to can be corrupt).
SQLITE_DBS=(
	"cozynights-staging=volume:hamburn-cozynights_pb_data_staging:data.db"
	# "cozynights-prod=volume:cozynights-prod_pb_data:data.db"
	"vaultwarden=/path/to/vaultwarden/data/db.sqlite3"
)

# PostgreSQL databases in containers: "name=container:user:database"
PG_DUMPS=(
	"listmonk=listmonk_db:listmonk:listmonk"
)

# Everything else needed to rebuild the server: configuration, certificates,
# secrets and uploaded files. A path that does not exist is an error. A local
# repository is never part of its own backup, even below one of these paths.
BACKUP_PATHS=(
	/etc/nginx
	/etc/letsencrypt
	/etc/cozynights
	/opt/hamburn-cozynights-staging/hamburn-cozynights/.env
	# /opt/hamburn-cozynights-prod/hamburn-cozynights/.env
	/path/to/vaultwarden/data
	/opt/docker-compose.yml
	# /root/.ssh/config   # with B
)

# Excluded from BACKUP_PATHS (restic --exclude patterns). The live SQLite
# files are already in the database copies above.
EXCLUDES=(
	'*.sqlite3'
	'*.sqlite3-wal'
	'*.sqlite3-shm'
	'*/vaultwarden/data/icon_cache'
)

# Retention (restic forget), applied once a day by the run in PRUNE_HOUR (UTC).
# The timer runs at 03:20 UTC, so PRUNE_HOUR must be 3. One snapshot a day for
# 14 days, then weekly and monthly. KEEP_HOURLY only matters when the timer
# runs more than once a day: it counts hours that HAVE a snapshot, not clock
# hours (0 = one snapshot per day, the newest).
KEEP_HOURLY=0
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
PRUNE_HOUR=3
# Weekly repository check + restore test on this weekday (1 = Monday,
# 7 = Sunday), in the run at PRUNE_HOUR.
CHECK_WEEKDAY=7

# Alert on failure: same webhook format as COZY_ADMIN_WEBHOOK_URL, e.g.
# 'https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>'
ALERT_WEBHOOK_URL=''
# Optional dead man's switch (alerts when backups stop running at all), e.g. a
# free check on https://healthchecks.io with period 1 day, grace 2 hours:
# 'https://hc-ping.com/<uuid>'
HEALTHCHECK_URL=''
