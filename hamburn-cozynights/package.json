{
	"name": "hamburn-cozynights",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:report": "vitest run --reporter=html",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"health": "npx tsx scripts/health_check.ts",
		"test:setup": "npx tsx scripts/test_setup.ts",
		"predev": "npm run health",
		"lint": "prettier --check . && eslint .",
		"typegen": "npx tsx scripts/secure_typegen.ts",
		"docs:ts": "typedoc --out docs/generated/ts src/lib",
		"docs:svelte": "node scripts/generate-svelte-docs.js",
		"docs:generate": "npm run docs:ts && npm run docs:svelte"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"@vitest/ui": "^5.0.1",
		"dotenv": "^17.4.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^17.12.0",
		"pocketbase-typegen": "^1.3.3",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"sveltedoc-parser": "^4.2.1",
		"tailwindcss": "^4.1.17",
		"typedoc": "^0.28.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"chart.js": "^4.5.1",
		"pocketbase": "^0.28.1",
		"svelte-chartjs": "^4.0.1"
	}
}
