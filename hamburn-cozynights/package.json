{
	"name": "hamburn-cozynights",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:report": "vitest run --reporter=html",
		"test:integration": "bash scripts/test-stack.sh integration",
		"test:smoke": "bash scripts/test-stack.sh smoke",
		"smoke:remote": "vitest run --config vitest.stack.config.ts tests/smoke",
		"verify": "npm run check && npm test && bash scripts/test-stack.sh integration smoke",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"health": "npx tsx scripts/health_check.ts",
		"test:setup": "npx tsx scripts/test_setup.ts",
		"predev": "npm run health",
		"lint": "prettier --check . && eslint .",
		"typegen": "npx tsx scripts/secure_typegen.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"@vitest/ui": "^4.1.4",
		"dotenv": "^17.4.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"pocketbase-typegen": "^1.3.3",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vitest": "^4.1.4"
	},
	"dependencies": {
		"@number-flow/svelte": "^0.4.2",
		"chart.js": "^4.5.1",
		"pocketbase": "^0.28.1",
		"qr": "^0.7.0"
	}
}
