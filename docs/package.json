{
	"name": "hamburn-cozynights-docs",
	"private": true,
	"type": "module",
	"description": "Documentation site for Hamburn CozyNights (VitePress, published to GitHub Pages)",
	"scripts": {
		"dev": "vitepress dev",
		"dev:public": "DOCS_AUDIENCE=public vitepress dev",
		"build": "vitepress build",
		"build:public": "DOCS_AUDIENCE=public vitepress build",
		"build:app": "npm run build:app:public && npm run build:app:admin",
		"build:app:public": "DOCS_AUDIENCE=public DOCS_BASE=/docs/ vitepress build --outDir .vitepress/dist/app/public",
		"build:app:admin": "DOCS_AUDIENCE=admin DOCS_BASE=/admin/docs/ vitepress build --outDir .vitepress/dist/app/admin",
		"preview": "vitepress preview",
		"preview:public": "DOCS_AUDIENCE=public vitepress preview"
	},
	"devDependencies": {
		"medium-zoom": "^1.1.0",
		"mermaid": "^11.17.2",
		"vitepress": "^2.0.0-alpha.20",
		"vue": "^3.5.43"
	}
}
