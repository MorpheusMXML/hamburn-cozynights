#!/bin/sh
# Refuses a commit that would publish a secret (docs/reference/security.md,
# "No secrets in git"). The repository is public, so this is the last stop
# before GitHub. Turn it on once per clone:
#
#   git config core.hooksPath .githooks
#
# Needs gitleaks (brew install gitleaks). The same rules run in CI
# (.github/workflows/ci.yml, job "Secrets") over the whole history.
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit refused." >&2
	exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner \
	--config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
